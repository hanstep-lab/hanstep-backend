# MySQL
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=hanstep

# RabbitMQ
RABBITMQ_DEFAULT_USER=hanstep
RABBITMQ_DEFAULT_PASS=change-me

# MongoDB Atlas Local (Vector Search)
# 호스트에서 접속: mongodb://hanstep:change-me@localhost:27017/?directConnection=true (MONGODB_PORT를 바꾸면 포트도 같이)
# 계정·비밀번호는 컨테이너 최초 생성 때만 적용됨. 바꿨다면 docker compose down -v 후 다시 up
MONGODB_PORT=27017
MONGODB_USER=hanstep
MONGODB_PASSWORD=change-me

# Cloudflare R2 (S3 호환. AI 서버와 같은 버킷)
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_REGION=auto
# 버킷: 비자 정책 원문 / 금융 상품 설명서·약관 원문 / 외국인등록증 이미지(비공개)
R2_POLICY_BUCKET=hanstep-visa-policies
R2_PRODUCT_BUCKET=hanstep-financial-products
R2_ARC_BUCKET=hanstep-arc-private

# Spring 내부 API 인증(X-Internal-Token). AI 서버 .env와 같은 값. 32자 미만이면 내부 API(/internal/v1) 전부 401
SPRING_INTERNAL_API_KEY=your-internal-api-key

# JWT 서명 키(Base64, 디코딩 후 32바이트 이상). 개인마다 따로 만들어 쓰고 공유하지 않음. 생성(PowerShell):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=your-base64-secret-32-bytes-or-more
# 액세스 토큰 유효 시간(초). 만료되면 FE가 /auth/entry 를 다시 호출
JWT_EXPIRES_IN_SECONDS=3600
