# 운영 배포(deploy/compose.prod.yml)용 환경 변수. deploy/.env 로 복사해 값을 채운다(.env 는 커밋 금지).
# 키 이름과 설명만 둔다. 비밀값은 서버에서 새로 만들고 로컬 .env 값을 재사용하지 않는다.
# 비밀번호는 MONGO_URI·RABBITMQ_URL 에 그대로 들어가므로 영문·숫자로 만든다. 생성(Linux): openssl rand -hex 24

# ---- 도메인(Caddy 자동 HTTPS) ----
# A 레코드가 서버 고정 IP 를 가리키는 도메인. 예: api.example.com
DOMAIN=

# ---- Swagger UI 기본 인증(Caddy) ----
# 둘 다 필수. 비어 있으면 compose 명령(up·ps·logs 등)이 전부 오류로 멈춘다
# 브라우저에서 /swagger-ui/index.html 을 열 때 입력하는 계정 이름
SWAGGER_BASIC_USER=
# 비밀번호의 bcrypt 해시(평문 아님). 생성: docker run --rm -it caddy:2 caddy hash-password
# 해시에 $ 가 들어 있으므로 반드시 작은따옴표로 감싼다. 예: SWAGGER_BASIC_HASH='$2a$14$...'
SWAGGER_BASIC_HASH=

# ---- MySQL ----
# root 비밀번호. 볼륨이 비어 있는 최초 기동 때만 적용된다(나중에 바꾸려면 볼륨을 지우고 다시 만들어야 함)
MYSQL_ROOT_PASSWORD=
# 데이터베이스 이름. Spring 기본값과 같은 hanstep 을 쓴다
MYSQL_DATABASE=

# ---- RabbitMQ ----
# 계정. 최초 기동 때만 적용된다. AI 서버의 RABBITMQ_URL 은 이 값으로 compose 가 만든다
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=

# ---- MongoDB Atlas Local ----
# 계정. 최초 기동 때만 적용된다. AI 서버의 MONGO_URI 는 이 값으로 compose 가 만든다
MONGODB_USER=
MONGODB_PASSWORD=

# ---- Spring ----
# JWT 서명 키(Base64, 디코딩 후 32바이트 이상). 생성(Linux): openssl rand -base64 32
JWT_SECRET=
# 액세스 토큰 유효 시간(초). 비우면 3600
JWT_EXPIRES_IN_SECONDS=
# JVM 옵션. 비우면 -Xmx768m(임시값, 서버 실측 후 조정)
SPRING_JAVA_OPTS=

# ---- 내부 API 키(Spring ↔ AI) ----
# AI → Spring 내부 API(/internal/v1) 인증 키(X-Internal-Token). 32자 이상.
# AI 쪽 SPRING_INTERNAL_API_KEY 와 같은 값이어야 한다(이 compose 는 같은 값을 Spring·ai-server·ai-worker·ocr-worker 에 넣는다).
# 32자 미만이면 내부 API 전부 401
SPRING_INTERNAL_API_KEY=
# Spring → AI 내부 API 토큰. 32자 이상, SPRING_INTERNAL_API_KEY 와 다른 값.
# Spring 과 AI 양쪽에 같은 값이 들어간다. AI /health/ready 의 internal_auth 가 이 값을 확인한다
AI_INTERNAL_API_TOKEN=

# ---- E-7-4 ----
# 승인 전(DRAFT) 규칙 버전도 계산에 쓸지(Spring·AI 공통). 비우면 false. 2026 규칙은 승인 상태(#95)라 운영은 비워 둔다
E74_INCLUDE_DRAFT_RULES=

# ---- 데모 계정 초기화(#131) ----
# POST /api/v1/demo/reset 을 열지(true/false). 비우면 false(404). 시연 리허설 동안만 true, 발표 뒤 false
DEMO_RESET_ENABLED=

# ---- 환율 수집기(#119) ----
# 한국수출입은행 현재환율 Open API 인증키. 백필·1시간 수집 전에 넣는다. 키는 이 파일(deploy/.env)에만 두고 코드·문서·로그에 쓰지 않는다
KOREAEXIM_API_KEY=
# 1시간 주기 수집(true/false). 비우면 false. Mock 정리 SQL 과 백필을 끝낸 뒤 true 로 바꾼다. 백필은 이 값과 관계없이 된다
FX_COLLECTOR_ENABLED=
# 수집할 통화(쉼표). 비우면 USD,PHP. PHP 는 Frankfurter(ECB), 나머지는 수출입은행 고시 통화(23개)만 받는다
FX_COLLECTOR_CURRENCIES=
# Frankfurter v2 주소. 비우면 https://api.frankfurter.dev/v2
FRANKFURTER_BASE_URL=

# ---- AI 서버 ----
# 챗봇 모델 호출 방식. anthropic: 실제 호출(유료) | fake: API 키 없이 가짜 답변.
# 비우면 anthropic(compose 기본값). AI 코드 기본값은 fake 라 compose 에서 anthropic 으로 넣는다
CHAT_LLM_MODE=
# Anthropic API 키. CHAT_LLM_MODE=anthropic 이면 필요
ANTHROPIC_API_KEY=
# 챗봇 프롬프트 버전. 비워 둔다. 비우면 v4.4(compose 기본값, 금융 정책 검색 + 환율 진단 도구)
# 운영 버전은 compose 기본값으로 정한다. 급히 되돌릴 때만 v4.1 을 넣고 ai-server 를 다시 만든다
CHAT_PROMPT_VERSION=
# 금융 정책 문서 폴더(ai-server 컨테이너 안 경로). 호스트 ~/hanstep/rag-data/finance-policy 가 여기로 마운트된다.
# 비우면 금융 정책 검색이 꺼진다(SEARCH_NOT_CONFIGURED)
FINANCE_POLICY_CORPUS_DIR=/data/finance-policy
# 금융 정책 검색 결과에 항 단위 라벨을 붙일지(true/false). 비우면 false
FINANCE_POLICY_LABELS=true
# 법제처 국가법령정보 공동활용 API 인증값(OC)
LAW_API_OC=
# 로드맵 단계 문장. true 면 LLM(ANTHROPIC_API_KEY 사용, 생성 1회당 호출 1번), 비우면 TEMPLATE(compose 기본값 false)
ROADMAP_LLM_TEXT=

# ---- Cloudflare R2(AI 서버 RAG 원문·외국인등록증 원본) ----
# hanstep-AI ai/.env.example 의 R2 항목 중 AI 서버 설정(app/core/config.py)이 읽는 키
# + 등록증 전용 키(맨 아래: spring 쓰기·삭제 R2_OCR_*, ocr-worker 읽기 전용 R2_OCR_WORKER_*)
# S3 엔드포인트만(https://<account_id>.r2.cloudflarestorage.com). 버킷 이름·경로를 붙이지 않는다
R2_ENDPOINT_URL=
# 리전. 비우면 auto
R2_REGION=
# 정책·상품 버킷에만 읽기·쓰기 권한이 있는 키
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 버킷 이름. 비우면 hanstep-visa-policies / hanstep-financial-products / hanstep-arc-private
# 세 버킷은 서로 달라야 한다(같으면 AI 서버가 시작 시 오류)
R2_POLICY_BUCKET=
R2_PRODUCT_BUCKET=
R2_ARC_BUCKET=
# 정책 원문 객체 키 접두사. 비우면 policy-sources(제안값, 백엔드와 확정 전)
R2_POLICY_PREFIX=
# 외국인등록증 버킷(R2_ARC_BUCKET) 전용 쓰기·삭제 키. spring 이 등록증 업로드(PutObject)와 확정·재업로드 시
# 원본 삭제(DeleteObject)에 쓴다(#73). 위 정책·상품 키와 다른 키. ai-server·ocr-worker 에는 넣지 않는다
R2_OCR_ACCESS_KEY_ID=
R2_OCR_SECRET_ACCESS_KEY=
# 외국인등록증 버킷(R2_ARC_BUCKET) 읽기 전용 키. ocr-worker 가 원본을 읽는 데(GetObject)만 쓴다.
# compose 가 ocr-worker 에 R2_OCR_ACCESS_KEY_ID·R2_OCR_SECRET_ACCESS_KEY 이름으로 넘긴다. 위 spring 키와 다른 키.
# 비어 있으면 ocr-worker 가 "worker not configured" 로 종료하고, 올린 등록증은 확인 대기로 넘어가지 않는다
R2_OCR_WORKER_ACCESS_KEY_ID=
R2_OCR_WORKER_SECRET_ACCESS_KEY=
