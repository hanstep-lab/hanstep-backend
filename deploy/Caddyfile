# {$DOMAIN} 은 deploy/.env 의 DOMAIN. 도메인의 A 레코드가 서버 IP 를 가리키고 80·443 이 열려 있으면 HTTPS 인증서를 자동 발급한다.
{$DOMAIN} {
	encode gzip

	# 내부 API 는 외부에서 막는다(내부 통신은 compose 네트워크에서 spring:8080 으로 직접)
	# 맨 끝 catch-all 에 기대지 않고 자기 handle 에서 직접 404 를 낸다(catch-all 이 바뀌어도 /internal 은 열리지 않음)
	@blocked path /internal/*
	handle @blocked {
		respond 404
	}

	# API 문서(Swagger UI)는 기본 인증을 통과해야 Spring 으로 전달한다. 계정·bcrypt 해시는 deploy/.env
	# 문서에는 /api/v1 만 나온다(Spring prod 프로필의 springdoc.paths-to-match)
	@swagger path /swagger-ui.html /swagger-ui/* /v3/api-docs /v3/api-docs/*
	handle @swagger {
		basic_auth {
			{$SWAGGER_BASIC_USER} {$SWAGGER_BASIC_HASH}
		}
		reverse_proxy spring:8080
	}

	# 외부 API 만 Spring 으로 전달. 챗봇 스트림(text/event-stream)은 Caddy 가 버퍼링 없이 바로 흘려보낸다
	handle /api/v1/* {
		reverse_proxy spring:8080
	}

	# 그 밖의 경로는 전달하지 않는다
	handle {
		respond 404
	}
}
